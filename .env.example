# Required: real PostgreSQL. Run node scripts/roster-migrate.mjs before serving.
DATABASE_URL=postgresql://roster_user:CHANGE_ME@127.0.0.1:5432/roster
# Exact browser-facing origin; no trailing slash. Requests with another Origin fail closed.
APP_ORIGIN=http://localhost:3000
# Production always uses Secure cookies, even behind a TLS reverse proxy.
SESSION_COOKIE_SECURE=false
# Optional real workspace access. Omit both credentials for demo-only deployment.
ROSTER_ADMIN_USERNAME=
# Generate via stdin: node scripts/roster-password-hash.mjs (scrypt$saltHex$keyHex)
# Quote hashes in shell env files to preserve dollar signs.
ROSTER_ADMIN_PASSWORD_HASH=
ROSTER_VIEWER_USERNAME=
ROSTER_VIEWER_PASSWORD_HASH=
ROSTER_REAL_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DEMO_TTL_SECONDS=86400
DEMO_MAX_WORKSPACES=200
DEMO_RATE_PER_10_MIN=40
# Integration tests only: point to a dedicated disposable database, NEVER production.
# TEST_DATABASE_URL=postgresql://...
# Test-only production-build HTTP loopback; cannot weaken public-origin cookies.
ALLOW_INSECURE_LOCALHOST=false
